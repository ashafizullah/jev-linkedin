{
  "manifest_version": 3,
  "name": "Jev Job Match",
  "version": "0.9.1",
  "description": "Menilai kecocokan lowongan LinkedIn dengan CV kamu dan mengestimasi peluang lolos seleksi, memakai model keputusan Jev.",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://api.typesafe.ai/*",
    "https://api.experientiallabs.ai/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/jobs/*"],
      "js": [
        "src/shared/messages.js",
        "src/shared/signals.js",
        "src/content/extract.js",
        "src/content/linkedin.js"
      ],
      "css": ["src/content/panel.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Jev Job Match"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
